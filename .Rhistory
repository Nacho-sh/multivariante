outlier(data)
else
return(data)
}
outlier<-function(data,na.rm=T){scatterplot3d(Al, Fe, Mg,
color = c("firebrick", "green3")[RBGlass1$Site],pch = 19,
grid = TRUE, xlab = "Al", ylab = "Fe",
zlab = "Mg", angle = 65, cex.axis = 0.6)
legend("topleft",
bty = "n", cex = 0.8,
title = "Site",
c("Mancetter", "Leicester"), fill = c("firebrick", "green3"))
H<-1.5*IQR(data)
data[data<quantile(data,0.25,na.rm = T)-H]<-NA
data[data>quantile(data,0.75, na.rm = T)+H]<-NA
data[is.na(data)]<-mean(data, na.rm = T)
H<-1.5*IQR(data)
if (TRUE %in% (data<quantile(data,0.25,na.rm = T)-H) |
TRUE %in% (data>quantile(data,0.75,na.rm = T)+H))
outlier(data)
else
return(data)
}
